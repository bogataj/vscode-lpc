{
  "name": "lpc-ldmud-lp245",
  "displayName": "LPC Language Support (LDMUD/LP-245)",
  "description": "Language support, syntax highlighting and formatting for LPC with LDMUD game driver and LP-245 mudlib",
  "version": "1.5.3",
  "publisher": "bogataj",
  "author": {
    "name": "Andreas Bogataj",
    "email": "andreas@bogga.se"
  },
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=24.11.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "lpc",
    "ldmud",
    "lp-245",
    "lp245",
    "mudlib",
    "game development",
    "mud"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:lpc"
  ],
  "contributes": {
    "languages": [{
      "id": "lpc",
      "aliases": ["LPC", "lpc", "LDMud"],
      "extensions": [".c", ".h", ".lpc"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "lpc",
      "scopeName": "source.lpc",
      "path": "./syntaxes/lpc.tmGrammar.json"
    }],
    "commands": [{
      "command": "lpc.format",
      "title": "Format LPC Code"
    }],
    "menus": {
      "commandPalette": [{
        "command": "lpc.format",
        "when": "editorLangId == lpc"
      }]
    },
    "configuration": {
      "type": "object",
      "title": "LPC",
      "properties": {
        "lpc.formatting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable LPC code formatting",
          "scope": "resource"
        },
        "lpc.formatting.indentSize": {
          "type": "number",
          "minimum": 1,
          "default": 4,
          "description": "Number of spaces for indentation",
          "scope": "resource"
        },
        "lpc.formatting.insertFinalNewline": {
          "type": "boolean",
          "default": true,
          "description": "Insert final newline at end of file",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "npm run clean && tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "tsc -p ./ --noEmit && tsc -p scripts",
    "test": "node --test out/test/unit/formatter.test.js && node ./out/test/runTest.js",
    "test:unit": "npm run compile && node --test out/test/unit/formatter.test.js",
    "package": "npm run compile && node scripts/package-vsix.mjs",
    "install:dev": "npm run package -- --out lpc-ldmud-lp245-dev.vsix && code --install-extension lpc-ldmud-lp245-dev.vsix --force"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.74.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bogataj/vscode-lpc"
  },
  "bugs": {
    "url": "https://github.com/bogataj/vscode-lpc/issues"
  },
  "homepage": "https://github.com/bogataj/vscode-lpc#readme",
  "license": "MIT"
}
