void configure() {
    items = ({
        "first","First part " +
                "second part " +
                "third part.",
        ({"second","alias"}),"Second value " +
                             "continues here.",
        "third","Third value " +
        /* local note */

                "survives trivia.",
    });
    labels = ([
        "key":"Mapping value " +
              "continues here.",
    ]);
    mixed values = (<
        "multiset value " +
        "continued",
    >);
    emit("Call argument " +
         "continues here.");
}
