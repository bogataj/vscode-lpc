int channel_command(string verb, string str) {
#ifdef DEBUG
if (this_player()->query_real_name() == "teros") {
write(verb + ":" + str + "\n");
}
#endif
if (str == "-h") {
string line;
foreach (line : CHANNELS->query_channel_history(query_verb())[..20, <0]) {
write(line);
}
return 1;
}

if ((query_verb() == "info" || query_verb() == "status") && !this_player()->query_wiz_level()) {
write("Endast magiker får skriva på den kanalen.\n");
return 0;
}

CHANNELS->send_message(verb, str);
return 1;
}
